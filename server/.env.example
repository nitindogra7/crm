# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration (Used by Docker Compose & Prisma)
POSTGRES_USER=salenova
POSTGRES_PASSWORD=salenova_dev_pw
POSTGRES_DB=salenova

# Prisma Database Connection URL
# For local machine connecting to Docker container on port 5433:
DATABASE_URL="postgresql://salenova:salenova_dev_pw@localhost:5433/salenova?schema=public"

# For API running inside Docker network:
# DATABASE_URL="postgresql://salenova:salenova_dev_pw@db:5432/salenova?schema=public"

# Authentication & Security Secrets (JWT / Cookies)
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d
